{
  "type": "split",
  "props": {"direction": "horizontal"},
  "children": [
    {
      "type": "stack",
      "props": {"direction": "vertical"},
      "children": [
        {
          "type": "stack",
          "props": {"direction": "horizontal"},
          "children": [
            {"type": "icon", "props": {"name": "folder"}},
            {"type": "text", "props": {"text": "clubmate", "style": "title"}},
            {"type": "badge", "props": {"text": "3", "tone": "accent"}}
          ]
        },
        {"type": "text", "props": {"text": "FILES", "style": "muted"}},
        {
          "type": "tree",
          "id": "files",
          "props": {
            "selected": "main-go",
            "items": [
              {
                "id": "cmd", "label": "cmd", "icon": "folder", "hasChildren": true, "expanded": true,
                "children": [
                  {
                    "id": "cmd-core", "label": "clubmate-core", "icon": "folder", "hasChildren": true, "expanded": true,
                    "children": [{"id": "main-go", "label": "main.go", "icon": "doc.text", "detail": "2 KB"}]
                  },
                  {"id": "cmd-cli", "label": "clubmate", "icon": "folder", "hasChildren": true, "expanded": false}
                ]
              },
              {"id": "internal", "label": "internal", "icon": "folder", "hasChildren": true, "expanded": false},
              {"id": "readme", "label": "README.md", "icon": "doc.richtext", "badge": "M"}
            ]
          }
        },
        {
          "type": "transcript",
          "id": "gallery-transcript",
          "props": {},
          "children": [
            {"type": "message", "id": "m1", "props": {"role": "user", "text": "Fix the dark theme: my messages render as blank beige bars with invisible text."}},
            {"type": "message", "id": "m2", "props": {"role": "agent", "text": "The bubble used the ghostty selection colour, which some themes set to the foreground."}}
          ]
        },
        {"type": "text", "props": {"text": "SESSIONS", "style": "muted"}},
        {
          "type": "list",
          "id": "sessions",
          "props": {
            "selected": "s2",
            "items": [
              {"id": "s1", "label": "zsh", "icon": "terminal", "detail": "~/clubmate"},
              {"id": "s2", "label": "make test", "icon": "terminal", "detail": "running", "badge": "live"},
              {"id": "s3", "label": "nvim", "icon": "terminal", "detail": "exited"}
            ]
          }
        }
      ]
    },
    {
      "type": "stack",
      "props": {"direction": "vertical"},
      "children": [
        {
          "type": "tabs",
          "id": "views",
          "props": {
            "selected": "overview",
            "items": [
              {"id": "overview", "label": "Overview", "icon": "square.grid.2x2"},
              {"id": "terminals", "label": "Terminals", "badge": "2"},
              {"id": "settings", "label": "Settings"}
            ]
          }
        },
        {
          "type": "split",
          "props": {"direction": "vertical"},
          "children": [
            {
              "type": "scroll",
              "children": [
                {
                  "type": "stack",
                  "props": {"direction": "vertical"},
                  "children": [
                    {"type": "text", "props": {"text": "Text styles", "style": "title"}},
                    {"type": "text", "props": {"text": "body: the quick brown fox", "style": "body"}},
                    {"type": "text", "props": {"text": "muted: secondary information", "style": "muted"}},
                    {"type": "text", "props": {"text": "mono: go test ./...", "style": "mono"}},
                    {
                      "type": "stack",
                      "props": {"direction": "horizontal"},
                      "children": [
                        {"type": "badge", "props": {"text": "neutral"}},
                        {"type": "badge", "props": {"text": "accent", "tone": "accent"}},
                        {"type": "badge", "props": {"text": "success", "tone": "success"}},
                        {"type": "badge", "props": {"text": "warning", "tone": "warning"}},
                        {"type": "badge", "props": {"text": "danger", "tone": "danger"}}
                      ]
                    },
                    {
                      "type": "stack",
                      "props": {"direction": "horizontal"},
                      "children": [
                        {"type": "icon", "props": {"name": "terminal"}},
                        {"type": "icon", "props": {"name": "gearshape"}},
                        {"type": "icon", "props": {"name": "bolt.fill"}},
                        {"type": "icon", "props": {"name": "no.such.symbol"}}
                      ]
                    },
                    {"type": "markdown", "props": {"text": "**markdown** with _emphasis_, `code` and a [link](https://example.com)"}},
                    {
                      "type": "stack",
                      "props": {"direction": "horizontal"},
                      "children": [
                        {"type": "text", "props": {"text": "CPU 37%", "style": "mono"}},
                        {"type": "sparkline", "props": {"values": [12, 30, 22, 48, 37, 61, 40, 37], "max": 100}}
                      ]
                    },
                    {
                      "type": "table",
                      "id": "procs",
                      "props": {
                        "columns": [
                          {"id": "name", "title": "Process"},
                          {"id": "cpu", "title": "CPU", "align": "right", "width": 70},
                          {"id": "mem", "title": "MEM", "align": "right", "width": 70},
                          {"id": "hist", "title": "History", "width": 70}
                        ],
                        "rows": [
                          {"id": "101", "hasChildren": true, "expanded": true, "cells": [
                            {"text": "zsh"}, {"text": "1.2%", "bar": 0.012}, {"text": "8 MB"}, {"spark": {"values": [1, 2, 1, 1, 2], "max": 100}}
                          ]},
                          {"id": "102", "depth": 1, "cells": [
                            {"text": "make test"}, {"text": "88%", "bar": 0.88, "tone": "danger"}, {"text": "640 MB", "tone": "warn"}, {"spark": {"values": [40, 70, 88, 92, 88], "max": 100}, "tone": "danger"}
                          ]},
                          {"id": "103", "hasChildren": true, "cells": [
                            {"text": "nvim"}, {"text": "4.0%", "bar": 0.04, "tone": "ok"}, {"text": "120 MB"}, {"spark": {"values": [3, 5, 4, 4, 4], "max": 100}}
                          ]},
                          {"id": "more", "muted": true, "cells": [{"text": "… 12 more"}, {}, {}, {}]}
                        ],
                        "sort": {"column": "cpu", "desc": true},
                        "selected": "102"
                      }
                    },
                    {
                      "type": "stack",
                      "props": {"direction": "horizontal"},
                      "children": [
                        {"type": "button", "id": "new", "props": {"label": "New session", "icon": "plus"}},
                        {"type": "button", "id": "refresh", "props": {"label": "Refresh", "action": "refresh"}},
                        {"type": "button", "id": "boom", "props": {"label": "Fail", "icon": "exclamationmark.triangle", "action": "fail"}}
                      ]
                    },
                    {
                      "type": "form",
                      "id": "settings-form",
                      "props": {"action": "settings.save"},
                      "children": [
                        {"type": "textField", "id": "name", "props": {"value": "clubmate", "placeholder": "Project name"}},
                        {
                          "type": "stack",
                          "props": {"direction": "horizontal"},
                          "children": [
                            {"type": "toggle", "id": "autostart", "props": {"value": true}},
                            {"type": "text", "props": {"text": "start sessions on open"}}
                          ]
                        },
                        {
                          "type": "select",
                          "id": "shell",
                          "props": {
                            "value": "zsh",
                            "options": [
                              {"value": "zsh", "label": "zsh"},
                              {"value": "bash", "label": "bash"},
                              {"value": "fish", "label": "fish"}
                            ]
                          }
                        },
                        {
                          "type": "stack",
                          "props": {"direction": "horizontal"},
                          "children": [
                            {"type": "button", "id": "save", "props": {"label": "Save", "icon": "checkmark"}},
                            {"type": "button", "id": "cancel", "props": {"label": "Cancel", "action": "settings.cancel"}}
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "split",
              "props": {"direction": "horizontal"},
              "children": [
                {"type": "surface", "props": {"sessionId": "ses_0123456789abcdef"}},
                {"type": "empty", "props": {"text": "No session selected"}}
              ]
            }
          ]
        }
      ]
    }
  ]
}
