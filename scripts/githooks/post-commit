#!/bin/sh
[ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" = main ] || exit 0
[ "$(cd "$(git rev-parse --absolute-git-dir)" && pwd -P)" = "$(cd "$(git rev-parse --git-common-dir)" && pwd -P)" ] || exit 0
sha=$(git rev-parse HEAD) || exit 0
log="$HOME/Library/Logs/clubmate-push-main.log"
nohup sh -c 'sleep 5; [ "$(git rev-parse main)" = "$1" ] || exit 0; echo "$(date) push $1"; git push -q origin "$1:refs/heads/main"' push-main "$sha" >>"$log" 2>&1 </dev/null &
exit 0
