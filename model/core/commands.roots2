module Commands "the commands of the core and of plugins: who may run one, and what an agent must get approved first" {
  core {
    code at "internal/rpc/methods_ui.go", "internal/rpc/primitives.go", "internal/rpc/caller_scope.go", "internal/rpc/approval.go"
    tests at "internal/rpc/agent_test.go", "internal/rpc/rpc_test.go", "internal/rpc/broadcast_test.go"
    docs at "docs/sdui-protocol.md" section "RPC methods"

    record Command {
      partial: its rows are made when the core starts and never change: the core's own (primitives.go:26-177) and those each manifest contributes, the first of two with one id kept (internal/plugin/manifest.go:164-187, internal/plugin/router.go:113-135); title, description, the schemas of args and result, `hidden`, `remote`, `confirm`, `provides`, `handles` and `timeout`; a capability name, which stands for the command of its provider (router.go:94-101); the reads command.list and command.capabilities, which any connection may ask (methods_ui.go:323-329, :401-413); command.broadcast, which passes a call to every command of an enabled plugin that `handles` a topic, side by side, and answers `plugin_error` with their refusals joined (internal/rpc/broadcast.go:22-53)
      id: CommandId, key
      plugin: PluginId, optional
      agent: Flag
      destructive: Flag
      app_wide: Flag
      inherited: `app_wide` is: needs no workspace. Of the core's own commands the destructive ones are session.kill and session.send, and the ones no agent may run are workspace.worktree.set and diagnostics.collect (primitives.go:46, :58, :93, :104)
    }

    port Agents "the agents plugin, asked through its command agents.sessions" {
      has(session: SessionRef, workspace: WorkspaceId): member | stranger | refused | unreachable | garbled
    }

    method run by client, plugin {
      partial: the answer, which is whatever the command answered; what a command of the core does once it may run: the core method of its name, for session.kill, session.send and session.read only on a session of the workspace named when an agent asks, else `denied` (primitives.go:227-240, :262-276, methods_ui.go:372-379); for an agent a core command that lists a workspace's things takes the workspace named (methods_ui.go:347-349)
      open: args that do not fit the command's schema are refused `invalid` once the workspace is found; then, for an agent, args with a key the schema does not declare, at any depth (methods_ui.go:361-370, primitives.go:249-260). A document cannot be looked into
      takes {
        id: CommandId
        workspaceId: WorkspaceId, optional
        args: Document, optional
        agent: Flag, default no
        inherited: `agent` and `session` are what the caller says of itself: agent mode is a cooperative guard, not a security boundary, since any process of the same user can call without it (docs/sdui-protocol.md § RPC methods; docs/agents.md § Approvals)
        session: SessionRef, optional
      }
      reject not_found unless a Command of id exists   // @ internal/rpc/methods_ui.go:336-343
      let c = Command of id
      if c.plugin != none {
        ask Plugins.must_be_on(c.plugin) { off { reject not_found } }
      }
      reject not_found if agent and not c.agent   // @ internal/rpc/methods_ui.go:344-346
      inherited: to an agent a command it may not run looks unknown, not forbidden (methods_ui.go:344-346; docs/sdui-protocol.md § RPC methods: "as if unknown")
      if not c.app_wide {
        reject invalid if workspaceId = none   // @ internal/rpc/methods_ui.go:350-360, :434-440
        ask Workspaces.require(workspaceId)
      }
      if agent and session != none and workspaceId != none and caller.plugin = none {   // @ internal/rpc/caller_scope.go:36-39
        open: only a `session` that begins with `agt_` is checked, the check is skipped when no enabled plugin has the command agents.sessions, and a `member` answer is remembered until the core stops (caller_scope.go:37-49, :64); no expression reads the start of a text
        ask Agents.has(session, workspaceId) within 2 seconds, once {   // @ internal/rpc/approval.go:26, internal/rpc/caller_scope.go:50-52
          member { change nothing }
          stranger { reject denied with "agents act only in their own workspace" }   // @ internal/rpc/caller_scope.go:68
          refused { reject plugin_error }
          unreachable { reject plugin_unavailable }
          garbled { reject internal }   // @ internal/rpc/caller_scope.go:53-61
          no answer { reject plugin_unavailable }
          inherited: so a call that could not be checked can be sent again (docs/sdui-protocol.md § RPC methods; internal/rpc/methods_report.go:267-286, internal/rpc/errors.go:152-155)
        }
      }
      if agent and c.destructive {   // @ internal/rpc/methods_ui.go:380-384
        open: before anyone is asked the args must be showable, else `invalid`: absent or an object of at most 10 fields, each at most 200 characters as shown and no number beyond 2^53, and no args at all for a command that declares none (approval.go:22-25, :211-236); what the user approved is exactly what runs
        ask Clients.approve(workspaceId, c.id, Payload(args = args))
      }
      if c.plugin != none {
        ask Plugins.call(c.plugin, command_run, Payload(args = args))   // @ internal/rpc/methods_ui.go:392-398
        inherited: the plugin also gets the workspace, `agent`, `session`, the terminal the call came from and, as `via`, the id of the plugin whose connection asked (methods_ui.go:128-136, :392-398)
      }
    }

    call "command.run" -> run {
      session from body "caller"
    }

    memory commands stores Command {
      id: CommandId, key
      plugin: PluginId, optional
      agent: Flag
      destructive: Flag
      app_wide: Flag
    }
  }
}
