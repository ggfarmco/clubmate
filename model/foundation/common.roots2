use foundation/go, foundation/json, foundation/sqlite, foundation/crossings

type Text "any text" {
  in Go: string
  in Json: string
  in Sqlite: text
}

type Flag "yes or no" {
  in Go: bool
  in Json: boolean
  in Sqlite: flag
}

type Time "an instant" {
  in Go: time
  in Json: string as rfc3339
  in Sqlite: integer as unix_nanos
  inherited: the databases keep nanoseconds since 1970 and no zone; every reader takes the instant
    as UTC or local time itself
}

type Document "a JSON document the model does not look inside" {
  in Go: raw_json
  in Json: object
  in Sqlite: text as json
}
