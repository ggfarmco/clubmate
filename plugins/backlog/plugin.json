      {
        "id": "backlog.add",
        "title": "Add Backlog Task",
        "hidden": true,
        "agent": true,
        "description": "Add a backlog task. From an agent it is added as idea; only the user puts tasks into todo, so ask the user to promote it. Use not_now to park a task.",
        "args": {
          "properties": {
            "title": {
              "type": "string",
              "description": "One line, up to 200 characters."
            },
            "description": {
              "type": "string",
              "description": "Markdown details an agent needs to act on the task, up to 32 KiB."
            },
            "priority": {
              "type": "string",
              "enum": [
                "high",
                "normal",
                "low"
              ],
              "description": "Priority; default normal."
            },
            "status": {
              "type": "string",
              "enum": [
                "idea",
                "todo",
                "not_now"
              ],
              "description": "Default todo from the user, idea from an agent (agents may not use todo)."
            }
          },
          "required": [
            "title"
