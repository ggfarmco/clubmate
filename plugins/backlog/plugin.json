      {
        "id": "backlog.start",
        "remote": true,
        "title": "Start agent on backlog task",
        "hidden": true,
        "description": "The user's Start agent: start an agent session on the task (agents.new with the title, description, links and attachments as the prompt) and hand the task to it. Allowed on idea and todo tasks, tasks you own and tasks whose owner session ended. Without the optional args it starts Claude in the workspace's first git folder in the worktree's last used mode, as the phone does. Not for agents.",
        "args": {
          "properties": {
            "id": {
              "type": "integer",
              "description": "Task number, as in #12."
            },
            "agent": {
              "type": "string",
              "enum": ["claude"],
              "description": "Agent to run."
            },
            "mode": {
              "type": "string",
              "enum": ["default", "acceptEdits", "plan", "bypassPermissions"],
              "description": "Mode the session starts in (agents.new firstMode); omit for the worktree's last used mode."
            },
            "where": {
              "type": "string",
              "enum": ["worktree"],
              "description": "worktree: run in a new worktree on branch backlog/<id>-<title slug> (the existing branch when it is there); omit for the workspace's first git folder."
            },
            "prompt": {
              "type": "string",
              "description": "Replaces the title, description, links and attachments part of the prompt; the line that hands the task to the session is kept."
            }
          },
          "required": [
            "id"
          ]
        },
        "result": {
          "properties": {
            "session": {
              "type": "string",
              "description": "The new agent session that owns the task."
            }
          }
        }
      },
      {
        "id": "backlog.takeback",
        "remote": true,
        "title": "Take back backlog task",
        "hidden": true,
        "description": "The user's Take back: the user becomes the owner of an in-progress task owned by someone else; the task stays in progress. Not for agents.",
        "args": {
          "properties": {
            "id": {
              "type": "integer",
              "description": "Task number, as in #12."
            }
          },
          "required": [
            "id"
          ]
        }
      },
      {
        "id": "backlog.claim",
        "remote": true,
        "title": "Claim backlog task",
        "hidden": true,
        "agent": true,
        "description": "Take a todo or idea task and mark it in progress under your name. Fails with who holds it when someone else has it; then pick another task. Claiming a task you already hold succeeds. A claim by a closed or deleted agent session is taken over.",
        "args": {
          "properties": {
            "id": {
              "type": "integer",
              "description": "Task number, as in #12."
            },
            "owner": {
              "type": "string",
              "description": "Needed only when you are not a Clubmate agent session: a name unique to you, e.g. your session id."
            }
          },
          "required": [
            "id"
          ]
        },
        "result": {
          "properties": {
            "id": {
              "type": "integer",
              "description": "Task number."
            },
            "title": {
              "type": "string",
              "description": "One-line title."
            },
            "description": {
              "type": "string",
              "description": "Markdown details."
            },
            "status": {
              "type": "string",
              "enum": [
                "idea",
                "todo",
                "in_progress",
                "done",
                "not_now"
              ],
              "description": "Task status."
            },
            "priority": {
              "type": "string",
              "enum": [
                "high",
                "normal",
                "low"
              ],
              "description": "Priority."
