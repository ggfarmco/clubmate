      {
        "id": "backlog.add",
        "remote": true,
        "title": "Add backlog task",
        "hidden": true,
        "agent": true,
        "description": "Add a backlog task. From an agent it is added as idea unless status says otherwise; pass status todo when the user asked for the task to be done. Use not_now to park a task.",
        "args": {
          "properties": {
            "title": {
              "type": "string",
              "description": "One line, up to 200 characters."
            },
            "description": {
              "type": "string",
              "description": "Markdown details an agent needs to act on the task, up to 32 KiB."
            },
            "priority": {
              "type": "string",
              "enum": [
                "high",
                "normal",
                "low"
              ],
              "description": "Priority; default normal."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tags, one word each of letters, digits, - _ . or / (lowercased, # dropped), up to 10 of 32 characters, e.g. [\"voice\", \"phone\"]."
            },
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "blocked_by",
                      "blocks",
                      "relates"
                    ],
                    "description": "blocked_by: this task waits for the other; blocks: the other waits for this one; relates: related."
                  },
                  "task": {
                    "type": "integer",
                    "description": "The other task's number."
