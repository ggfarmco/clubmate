      {
        "id": "backlog.claim",
        "title": "Claim Backlog Task",
        "hidden": true,
        "agent": true,
        "description": "Take a todo or idea task and mark it in progress under your name. Fails with who holds it when someone else has it; then pick another task. Claiming a task you already hold succeeds. A claim by a closed or deleted agent session is taken over.",
        "args": {
          "properties": {
            "id": {
              "type": "integer",
              "description": "Task number, as in #12."
            },
            "owner": {
              "type": "string",
              "description": "Needed only when you are not a Clubmate agent session: a name unique to you, e.g. your session id."
            }
          },
          "required": [
            "id"
