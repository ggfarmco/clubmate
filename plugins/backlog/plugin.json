{
  "id": "backlog",
  "name": "Backlog",
  "version": "0.1.0",
  "protocol": 1,
  "command": [
    "backlog"
  ],
  "contributes": {
    "sections": [
      {
        "id": "backlog",
        "title": "Backlog",
        "icon": "checklist",
        "order": 27
      }
    ],
    "commands": [
      {
        "id": "backlog.new",
        "title": "New Backlog Task",
        "description": "Show the Backlog section to add a task."
      },
      {
        "id": "backlog.list",
        "title": "List Backlog Tasks",
        "hidden": true,
        "agent": true,
        "description": "List this workspace's backlog tasks ordered by priority, then oldest first (done: newest first). Workflow: list status todo, pick the first, claim it, record progress with backlog.update note, finish with backlog.done and a note naming the commit, or backlog.release when you give up. Only the user puts tasks into todo; tasks you find yourself go in as idea.",
        "args": {
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "idea",
                "todo",
                "in_progress",
                "done",
                "not_now",
                "open"
              ],
              "default": "open",
              "description": "One status, or open = idea + todo + in_progress."
            },
            "limit": {
              "type": "integer",
              "description": "Return at most this many tasks."
            }
          }
        },
        "result": {
          "properties": {
            "tasks": {
              "type": "array",
              "description": "Tasks in order.",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "description": "Task number."
                  },
                  "title": {
                    "type": "string",
                    "description": "One-line title."
                  },
                  "description": {
                    "type": "string",
                    "description": "Markdown details."
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "idea",
                      "todo",
                      "in_progress",
                      "done",
                      "not_now"
                    ],
                    "description": "Task status."
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "high",
                      "normal",
                      "low"
                    ],
                    "description": "Priority."
                  },
                  "claimedBy": {
                    "type": "string",
                    "description": "Owner while in_progress."
                  },
                  "claimedAt": {
                    "type": "string",
                    "description": "When the claim was made, RFC 3339."
                  },
                  "claimedFrom": {
                    "type": "string",
                    "description": "Status before the claim."
                  },
                  "lastClaimedBy": {
                    "type": "string",
                    "description": "Who held the task before it was released or taken over."
                  },
                  "note": {
                    "type": "string",
                    "description": "Last progress or result note."
                  },
                  "createdBy": {
                    "type": "string",
                    "description": "user, an agent session id or agent."
                  },
                  "createdAt": {
                    "type": "string",
                    "description": "RFC 3339."
                  },
                  "updatedAt": {
                    "type": "string",
                    "description": "RFC 3339."
                  }
                }
              }
            }
          }
        }
      },
