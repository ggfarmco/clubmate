                "todo",
                "done",
                "not_now"
              ],
              "description": "New status."
            },
            "note": {
              "type": "string",
              "description": "Progress or result note, e.g. \"merged in abc123\" or \"blocked on X\"."
            }
          },
          "required": [
            "id"
