      {
        "id": "backlog.update",
        "title": "Update Backlog Task",
        "hidden": true,
        "agent": true,
        "description": "Change a task's title, description, priority, note or status. Cannot set in_progress (use backlog.claim); moving a task out of in_progress drops its claim. Agents may not set todo and may not change the status of a task claimed by someone else. Delete is not available; use not_now.",
        "args": {
          "properties": {
            "id": {
              "type": "integer",
              "description": "Task number, as in #12."
            },
            "title": {
              "type": "string",
              "description": "New title."
            },
            "description": {
              "type": "string",
              "description": "New description."
